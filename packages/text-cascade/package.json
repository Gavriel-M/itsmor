{
  "name": "text-cascade",
  "version": "0.1.0",
  "description": "React component for per-character staggered text reveal, with an optional glow-morph between two labels.",
  "keywords": [
    "react",
    "react-component",
    "animation",
    "text-animation",
    "text-reveal",
    "stagger",
    "cascade",
    "typography"
  ],
  "homepage": "https://github.com/Gavriel-M/itsmor/tree/main/packages/text-cascade",
  "bugs": {
    "url": "https://github.com/Gavriel-M/itsmor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gavriel-M/itsmor.git",
    "directory": "packages/text-cascade"
  },
  "license": "MIT",
  "author": "Gavriel Mor (https://itsmor.com)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
